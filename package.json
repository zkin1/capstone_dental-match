{
  "name": "dental-matching-system",
  "version": "3.0.0",
  "description": "Demo de asignación dental con monolito modular hexagonal y matching determinista",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js --watch src",
    "dev:full": "concurrently \"npm run dev\" \"npm --prefix client run dev\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest --testPathPattern=unit",
    "test:integration": "jest --testPathPattern=integration",
    "test:ai-agent": "node scripts/check-ai-agent.js",
    "lint": "eslint server.js src scripts --ext .js",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write \"server.js\" \"src/**/*.js\" \"scripts/**/*.js\"",
    "migrate": "node scripts/migrate.js migrate",
    "migrate:status": "node scripts/migrate.js status",
    "db:inventory:mysql": "node scripts/migrate-mysql-to-postgres.js inventory",
    "db:migrate:mysql": "node scripts/migrate-mysql-to-postgres.js migrate",
    "db:create-admin": "node scripts/create-admin.js",
    "build": "npm run lint && npm run test",
    "validate": "npm run lint && npm run test:coverage",
    "precommit": "npm run lint:fix && npm run format"
  },
  "keywords": [
    "odontologia",
    "matching",
    "pacientes",
    "estudiantes",
    "weighted-matching",
    "modular-monolith",
    "healthcare"
  ],
  "author": "Dental Matching Team",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.6",
    "dotenv": "^17.2.1",
    "express": "^4.19.2",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.1.0",
    "joi": "^18.0.1",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "mysql2": "^3.24.4",
    "nodemon": "^3.1.10",
    "prettier": "^3.2.4",
    "supertest": "^6.3.4"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "overrides": {
    "qs": "^6.16.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dental-matching/dental-matching-system.git"
  },
  "bugs": {
    "url": "https://github.com/dental-matching/dental-matching-system/issues"
  },
  "homepage": "https://github.com/dental-matching/dental-matching-system#readme"
}
