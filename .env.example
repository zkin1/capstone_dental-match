# Aplicación
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
TZ=America/Santiago

# PostgreSQL. En producción basta con DATABASE_URL.
DATABASE_URL=
DB_SCHEMA=dental_match

# Alternativa local cuando no se usa DATABASE_URL.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dental_matching
DB_USER=dental_app
DB_PASSWORD=cambia-esta-clave-de-aplicacion
DB_CONNECTION_LIMIT=2

# Origen MySQL usado únicamente por el inventario y la copia inicial.
MYSQL_SOURCE_URL=
MYSQL_SOURCE_HOST=localhost
MYSQL_SOURCE_PORT=3306
MYSQL_SOURCE_DATABASE=dental_matching
MYSQL_SOURCE_USER=dental_app
MYSQL_SOURCE_PASSWORD=

# Cookies de sesión firmadas con JWT (usa secretos aleatorios de 32+ caracteres)
JWT_SECRET=cambia-este-secreto-de-al-menos-32-caracteres
JWT_REFRESH_SECRET=cambia-este-otro-secreto-de-al-menos-32-caracteres
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# Alta inicial: npm run db:create-admin
ADMIN_EMAIL=admin@ejemplo.cl
ADMIN_PASSWORD=CambiaEstaClave123!
ADMIN_NAME=Administrador

# Servicio de pre-categorización. El matching nunca llama al LLM.
AI_AGENT_URL=http://localhost:8001
AI_AGENT_TOKEN=
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=
