# Configura exactamente una clave en Vercel: GEMINI_API_KEY o XAI_API_KEY.
GEMINI_API_KEY=
XAI_API_KEY=
# Opcional: sobrescribe el modelo por defecto del proveedor elegido.
LLM_MODEL=
# Solo para Ollama local si no hay clave externa:
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
# Debe coincidir con AI_AGENT_TOKEN del backend; nunca subir el valor real.
AI_AGENT_TOKEN=

# Server
HOST=0.0.0.0
PORT=8001
